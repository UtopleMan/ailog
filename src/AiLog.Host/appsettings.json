{
  "Logging": {
    "LogLevel": {
      "Default": "Warning"
    }
  },
  "AiLog": {
    "Port": 5100,
    "LogsPath": "logs",
    "Routes": {
      "anthropic": "https://api.anthropic.com",
      "openai": "https://api.openai.com"
    },
    "RedactHeaders": [
      "authorization",
      "proxy-authorization",
      "x-api-key",
      "api-key",
      "x-goog-api-key",
      "cookie",
      "set-cookie"
    ]
  }
}
