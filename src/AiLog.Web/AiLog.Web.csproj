<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Placeholder rewriting drops index.html when this app is published through AiLog.Host (SDK 10.0.301),
         so index.html is a plain static asset and references the unfingerprinted boot script. -->
    <OverrideHtmlAssetPlaceholders>false</OverrideHtmlAssetPlaceholders>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Served by ailog under /_ailog/ so the UI never collides with proxy routes. -->
    <StaticWebAssetBasePath>_ailog</StaticWebAssetBasePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="4.1.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdig references MemoryMarshal through the System.Memory facade; trimming drops the facade's forwarders
         and Markdig then fails at runtime with a TypeLoadException. -->
    <TrimmerRootAssembly Include="System.Memory" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AiLog.Contracts\AiLog.Contracts.csproj" />
    <ProjectReference Include="..\AiLog.Shared\AiLog.Shared.csproj" />
  </ItemGroup>

</Project>
