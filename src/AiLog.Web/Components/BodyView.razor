@* A logged body as text: JSON indented, text as-is, binary only described. *@
@inject IJSRuntime JS

@if (Body is null)
{
    <p class="notice">No body.</p>
}
else
{
    <div class="body-meta">
        <span>@Body.Format.ToString().ToLowerInvariant()</span>
        <span>@Display.Bytes(Body.SizeBytes) on the wire</span>
        @if (Body.ContentEncoding is { } encoding)
        {
            <span>@encoding</span>
        }
        <span class="spacer"></span>
        @if (Text is { } text)
        {
            <button class="link-button" @onclick="() => Copy(text)">Copy</button>
        }
    </div>
    @if (Body.Note is { } note)
    {
        <p class="warning">@note</p>
    }
    @if (Text is { } shown)
    {
        <pre class="code @(Body.Format == BodyFormat.Text ? "wrap" : "")">@shown</pre>
    }
    else
    {
        <p class="notice">Binary content (@Display.Bytes(Body.SizeBytes)), stored as base64 in the log file.</p>
    }
}

@code {
    [Parameter, EditorRequired] public LoggedBody? Body { get; set; }

    private LoggedBody? _formattedFor;

    private async Task Copy(string text) => await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);

    private string? _text;

    /// <summary>Formatted once per body; large bodies are expensive to indent on every render.</summary>
    private string? Text
    {
        get
        {
            if (!ReferenceEquals(_formattedFor, Body))
            {
                _formattedFor = Body;
                _text = Body?.Format switch
                {
                    BodyFormat.Json => Json.Format(Body.Content),
                    BodyFormat.Text => Body.Content.GetString(),
                    _ => null,
                };
            }

            return _text;
        }
    }
}
