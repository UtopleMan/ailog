@inherits LayoutComponentBase
@implements IDisposable
@inject LogFeed Feed

<div class="shell">
    <header class="topbar">
        <span class="brand">ailog</span>
        <span class="count">@Feed.Items.Count requests</span>
        <span class="feed-state @StateClass" title="@StateTitle">
            <span class="dot"></span>@StateLabel
        </span>
        <span class="spacer"></span>
        <BbDarkModeToggle />
    </header>
    <main class="content">
        @Body
    </main>
</div>

<BbPortalHost />

@code {
    private string StateClass => Feed.State.ToString().ToLowerInvariant();

    private string StateLabel => Feed.State switch
    {
        FeedState.Live => "live",
        FeedState.Reconnecting => "reconnecting",
        _ => "connecting",
    };

    private string StateTitle => Feed.State == FeedState.Live
        ? "New log files appear as they are written"
        : "Not receiving updates; retrying every 2 seconds";

    protected override void OnInitialized()
    {
        Feed.Changed += OnFeedChanged;
        Feed.Start();
    }

    private void OnFeedChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
