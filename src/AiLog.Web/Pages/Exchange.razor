@page "/exchanges/{Id}"
@implements IDisposable
@inject ExchangeLogClient Logs
@inject LogFeed Feed
@inject IJSRuntime JS

<PageTitle>ailog · @(log is null ? Id : $"#{log.Sequence} {summaryPath}")</PageTitle>

<div class="detail-scroll">
    <div class="detail">
        <div class="detail-header">
            <a class="back" href="./">← All requests</a>
            @if (log is not null)
            {
                <span class="mono">#@log.Sequence</span>
                <span class="mono">@log.Request.Method</span>
                <span class="mono path" title="@log.Request.Target">@summaryPath</span>
                <BbBadge Variant="@Display.StatusVariant(log.Response?.StatusCode)">@Display.Status(log.Response?.StatusCode)</BbBadge>
                @if (Display.Outcome(log.Outcome) is { } outcome)
                {
                    <BbBadge Variant="BadgeVariant.Outline">@outcome</BbBadge>
                }
            }
            <span class="spacer"></span>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="@NeighbourHref(Older)" Disabled="@(NeighbourHref(Older) is null)">← Older</BbButton>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="@NeighbourHref(Newer)" Disabled="@(NeighbourHref(Newer) is null)">Newer →</BbButton>
        </div>

        @if (result is null)
        {
            <p class="notice">Loading…</p>
        }
        else if (result.Outcome == LoadOutcome.NotFound)
        {
            <p class="notice">No log file named <code>@Id</code>. <a href="./">Back to all requests</a></p>
        }
        else if (result.Outcome == LoadOutcome.Failed)
        {
            <p class="warning">Could not load the log: @result.Error</p>
        }
        else if (log is not null && analysis is not null && stream is not null)
        {
            <ExchangeOverview Log="log" Analysis="analysis" />

            <ContextCard Analysis="analysis" OnSelect="Reveal" />

            <BbCard Class="detail-card">
                <BbCardHeader><BbCardTitle>Request</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    <BbTabs @bind-Value="requestTab">
                        <BbTabsList>
                            @if (analysis.Request is not null)
                            {
                                <BbTabsTrigger Value="@Conversation">Conversation</BbTabsTrigger>
                            }
                            <BbTabsTrigger Value="@Body">Body</BbTabsTrigger>
                            <BbTabsTrigger Value="@HeadersTab">Headers</BbTabsTrigger>
                        </BbTabsList>
                        @if (analysis.Request is { } requestTree)
                        {
                            <BbTabsContent Value="@Conversation">
                                <ConversationTree Segments="requestTree.Children.Where(c => c.Children.Count > 0)" State="view" />
                            </BbTabsContent>
                        }
                        <BbTabsContent Value="@Body"><BodyView Body="log.Request.Body" /></BbTabsContent>
                        <BbTabsContent Value="@HeadersTab"><HeadersTable Headers="log.Request.Headers" /></BbTabsContent>
                    </BbTabs>
                </BbCardContent>
            </BbCard>

            <BbCard Class="detail-card">
                <BbCardHeader>
                    <BbCardTitle>Response</BbCardTitle>
                    @if (analysis.Response?.Note is { } responseNote)
                    {
                        <BbCardDescription>@responseNote</BbCardDescription>
                    }
                </BbCardHeader>
                <BbCardContent>
                    @if (log.Response is null)
                    {
                        <p class="notice">The upstream never returned response headers.</p>
                    }
                    else
                    {
                        <BbTabs @bind-Value="responseTab">
                            <BbTabsList>
                                @if (HasOutput)
                                {
                                    <BbTabsTrigger Value="@Conversation">Conversation</BbTabsTrigger>
                                }
                                <BbTabsTrigger Value="@Body">Body</BbTabsTrigger>
                                <BbTabsTrigger Value="@HeadersTab">Headers</BbTabsTrigger>
                            </BbTabsList>
                            @if (HasOutput && analysis.Response is { } responseTree)
                            {
                                <BbTabsContent Value="@Conversation">
                                    <ConversationTree Segments="responseTree.Children" State="view" />
                                </BbTabsContent>
                            }
                            <BbTabsContent Value="@Body">
                                <ResponseBodyView Response="log.Response" Analysis="analysis" Stream="stream" />
                            </BbTabsContent>
                            <BbTabsContent Value="@HeadersTab"><HeadersTable Headers="log.Response.Headers" /></BbTabsContent>
                        </BbTabs>
                    }
                </BbCardContent>
            </BbCard>
        }
    </div>
</div>

@code {
    private const string Conversation = "conversation";
    private const string Body = "body";
    private const string HeadersTab = "headers";

    // Steps through the newest-first feed.
    private const int Older = 1;
    private const int Newer = -1;

    private readonly CancellationTokenSource disposed = new();
    private string? loadedId;
    private LoadResult? result;
    private ExchangeLog? log;
    private ExchangeAnalysis? analysis;
    private string summaryPath = "";
    private SegmentViewState view = new();
    private StreamBodyState? stream;
    private string? requestTab;
    private string? responseTab;
    private string? pendingScroll;

    [Parameter] public string Id { get; set; } = "";

    private bool HasOutput => analysis?.Response is { Children.Count: > 0 };

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    protected override async Task OnParametersSetAsync()
    {
        // Older/newer navigation reuses this component with a new id.
        if (loadedId == Id)
        {
            return;
        }

        loadedId = Id;
        result = null;
        log = null;
        analysis = null;

        result = await Logs.LoadAsync(Id, disposed.Token);
        if (result.Log is { } loaded)
        {
            Show(loaded);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingScroll is { } id)
        {
            pendingScroll = null;
            await JS.InvokeVoidAsync("ailog.scrollToId", disposed.Token, id);
        }
    }

    public void Dispose()
    {
        Feed.Changed -= OnFeedChanged;
        disposed.Cancel();
        disposed.Dispose();
    }

    private void Show(ExchangeLog loaded)
    {
        log = loaded;
        summaryPath = LogPath(loaded);
        analysis = ExchangeAnalysis.Analyze(loaded);
        view = SegmentViewState.For(analysis);
        stream = new StreamBodyState(analysis);
        requestTab = analysis.Request is not null ? Conversation : Body;
        responseTab = HasOutput ? Conversation : Body;
    }

    private void Reveal(ContextSegment segment)
    {
        if (segment.Id.StartsWith(ExchangeAnalysis.RequestIdPrefix, StringComparison.Ordinal))
        {
            requestTab = Conversation;
        }
        else
        {
            responseTab = Conversation;
        }

        view.Reveal(segment);
        pendingScroll = segment.Id;
    }

    private string? NeighbourHref(int step)
    {
        IReadOnlyList<ExchangeSummary> items = Feed.Items;
        for (int i = 0; i < items.Count; i++)
        {
            if (items[i].Id == Id)
            {
                int neighbour = i + step;
                return neighbour >= 0 && neighbour < items.Count ? $"exchanges/{Uri.EscapeDataString(items[neighbour].Id)}" : null;
            }
        }

        return null;
    }

    private static string LogPath(ExchangeLog exchange)
    {
        string prefix = "/" + exchange.Route;
        string target = exchange.Request.Target;
        return target.StartsWith(prefix, StringComparison.OrdinalIgnoreCase) ? target[prefix.Length..] : target;
    }

    private void OnFeedChanged() => InvokeAsync(StateHasChanged);
}
