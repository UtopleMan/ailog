@page "/"
@implements IDisposable
@inject LogFeed Feed
@inject NavigationManager Navigation

<PageTitle>ailog</PageTitle>

<div class="grid-scroll">
    <BbDataGrid TData="ExchangeSummary" Items="Feed.Items" ItemKey="@(summary => summary.Id)"
                Virtualize="true" ShowPagination="false" StickyHeader="true" OnRowClick="Open" Class="clickable-rows">
        <Columns>
            <BbDataGridTemplateColumn Title="Time" Width="120px" Context="summary">
                <span class="mono" title="@Display.FullTime(summary.StartedAt)">@Display.Time(summary.StartedAt)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="#" Width="70px" CellClass="num" HeaderClass="num" Context="summary">
                <span class="mono">@summary.Sequence</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Method" Width="90px" Context="summary">
                <span class="mono">@summary.Method</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Route" Width="110px" Context="summary">
                @summary.Route
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Path" NoWrap="true" Context="summary">
                <span class="mono" title="@summary.Path">@summary.Path</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Status" Width="90px" Context="summary">
                <BbBadge Variant="@Display.StatusVariant(summary)">@Display.Status(summary.StatusCode)</BbBadge>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Duration" Width="100px" CellClass="num" HeaderClass="num" Context="summary">
                <span class="mono">@Display.Duration(summary.DurationMs)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="In" Width="80px" CellClass="num" HeaderClass="num" Context="summary">
                <span class="mono" title="@Display.InputBreakdown(summary.Usage)">@Display.Tokens(summary.Usage?.InputTokens)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Out" Width="80px" CellClass="num" HeaderClass="num" Context="summary">
                <span class="mono" title="@($"{Display.ExactTokens(summary.Usage?.OutputTokens)} output tokens")">@Display.Tokens(summary.Usage?.OutputTokens)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Size" Width="160px" CellClass="num" HeaderClass="num" Context="summary">
                <span class="mono">@Display.Bytes(summary.RequestBytes) → @Display.Bytes(summary.ResponseBytes)</span>
            </BbDataGridTemplateColumn>
            <BbDataGridTemplateColumn Title="Outcome" Width="130px" Context="summary">
                @if (Display.Outcome(summary.Outcome) is { } outcome)
                {
                    <BbBadge Variant="BadgeVariant.Outline">@outcome</BbBadge>
                }
            </BbDataGridTemplateColumn>
        </Columns>
        <EmptyTemplate>
            <p class="notice">No requests logged yet. Point your harness at this ailog instance, e.g. <code>ANTHROPIC_BASE_URL=@ProxyExample</code>.</p>
        </EmptyTemplate>
    </BbDataGrid>
</div>

@code {
    // The UI lives at /_ailog/, proxy routes sit next to it at the root.
    private string ProxyExample => new Uri(new Uri(Navigation.BaseUri), "/anthropic").ToString();

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    private void Open(ExchangeSummary summary) => Navigation.NavigateTo($"exchanges/{Uri.EscapeDataString(summary.Id)}");

    private void OnFeedChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
