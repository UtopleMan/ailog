<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Named the way the host's publish embeds the UI; app.css as a Windows publish names it. -->
    <EmbeddedResource Include="EmbeddedUi/index.html" LogicalName="ui/_ailog/index.html" />
    <EmbeddedResource Include="EmbeddedUi/app.css" LogicalName="ui/_ailog\css\app.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AiLog.Host\AiLog.Host.csproj" />
  </ItemGroup>

</Project>
